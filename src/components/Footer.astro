---
/**
 * Custom Footer — the default Starlight Footer (v0.39.2) with a small
 * builder credit line appended. Styling follows the muted footer text
 * conventions already used by Starlight (--sl-color-gray-3).
 */
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>
<p class="zs-credit">
	built by <a href="https://adampang.com">Adam Pangelinan</a>
</p>

<style>
	.zs-credit {
		margin-top: 1rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.zs-credit a {
		color: var(--sl-color-gray-3);
		text-decoration: underline;
	}
	.zs-credit a:hover {
		color: var(--sl-color-white);
	}
</style>
